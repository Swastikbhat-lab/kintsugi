{
  "name": "kintsugi",
  "version": "0.2.0",
  "description": "A self-healing repair loop for codebases: observes failing checks (tests, typecheck, lint, custom), repairs the ones with a provable fix, verifies every repair by re-running the checks, and quarantines the rest with evidence. Packaged as a Claude skill.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kintsugi": "./dist/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/cli.ts --source fixture --config fixture/kintsugi.config.json --llm-mock fixture/proposals/tax-rate.json --state .kintsugi-demo/state.json --quarantined-ok",
    "demo:dry": "tsx src/cli.ts --source fixture --config fixture/kintsugi.config.json --dry",
    "demo:ci": "tsx src/cli.ts --source fixture --config fixture/kintsugi.config.json --llm-mock fixture/proposals/tax-rate.json --state .kintsugi-ci/state.json --quarantined-ok",
    "demo:reset": "git checkout -- fixture && rm -rf .kintsugi-demo .kintsugi-ci"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@langfuse/client": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
