# Copy to .env for local development (Probot loads it automatically).

# From your GitHub App's settings page (https://github.com/settings/apps/<name>).
APP_ID=123456

# The app's private key — paste the whole PEM including the BEGIN/END lines.
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# The webhook secret you set when creating the app.
WEBHOOK_SECRET=development

# Local development only: GitHub cannot reach localhost, so tunnel webhooks
# through smee.io. `npx smee --url https://smee.io/<your-channel>` forwards
# to your local server. Omit entirely in production (the host provides the
# URL).
# WEBHOOK_PROXY_URL=https://smee.io/your-channel

# Optional overrides:
# KINTSUGI_CLI=/absolute/path/to/kintsugi/dist/cli.js
# ANTHROPIC_API_KEY=...    # enables the model proposer for rule-less findings
